{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": ".",
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "types": [
      "vitest/globals",
      "node"
    ]
  },
  "files": [],
  "references": [
    {
      "path": "./apps/api-gateway/tsconfig.app.json"
    },
    {
      "path": "./apps/user-service/tsconfig.app.json"
    },
    {
      "path": "./apps/upload-service/tsconfig.app.json"
    },
    {
      "path": "./apps/etl-service/tsconfig.app.json"
    },
    {
      "path": "./apps/contact-service/tsconfig.app.json"
    },
    {
      "path": "./apps/sharing-service/tsconfig.app.json"
    },
    {
      "path": "./apps/contact-hub-server/tsconfig.app.json"
    },
    {
      "path": "./apps/daily_upload_usage/tsconfig.app.json"
    },
    {
      "path": "./apps/daily_share_usage/tsconfig.app.json"
    },
    {
      "path": "./apps/share-usage-service/tsconfig.app.json"
    },
    {
      "path": "./apps/upload-usage-service/tsconfig.app.json"
    },
    {
      "path": "./tsconfig.spec.json"
    }
  ]
}